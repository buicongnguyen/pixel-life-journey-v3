{
  "name": "pixel-life-journey-v3",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "Pixel Life Journey — a 2D pixel-art life simulation. Walk a character left-to-right through every stage of life, balance Health, Happiness, Wealth, Fun and Smarts, and read the story of the life you lived.",
  "scripts": {
    "dev": "vite",
    "generate:training": "node scripts/generate-training-questions.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/three": "^0.185.4",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "dependencies": {
    "three": "^0.186.0"
  }
}
